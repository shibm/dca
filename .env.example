# -------------------------------------------------------------
# DCA (Document & Contract Analysis) Environment Configuration
# -------------------------------------------------------------

# Environment
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=dca_user
POSTGRES_PASSWORD=dca_secure_password
POSTGRES_DB=dca_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dca_user:dca_secure_password@localhost:5432/dca_db

# Redis (Task Queue & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=dca-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# Node.js BFF Service
BFF_PORT=4000
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# Python Processor Service
PROCESSOR_PORT=8000
PROCESSOR_HOST=0.0.0.0

# AI Provider Configuration
# Choose provider: gemini | openai | anthropic | mock
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# Processing Parameters
MAX_FILE_SIZE_MB=50
OCR_FALLBACK_ENABLED=true
CONFIDENCE_THRESHOLD=0.75

